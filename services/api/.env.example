# -----------------------------------------------------------------------------
# FLOWPAY PRODUCTION & ENVIRONMENT CONFIGURATION TEMPLATE
# -----------------------------------------------------------------------------
# Copy this file to .env or configure these variables in your deployment platform
# (e.g. Render, Northflank, Railway, AWS, Heroku).
# DO NOT commit actual secrets or credentials to source control.
# -----------------------------------------------------------------------------

# =============================================================================
# 1. DATABASE & REDIS INFRASTRUCTURE (Aiven / Managed Provider Agnostic)
# =============================================================================
# Aiven PostgreSQL / Managed PostgreSQL Connection String
# Example (Aiven): postgresql://avro_admin:PASSWORD@postgres-123.aivencloud.com:23456/defaultdb?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/flowpay?sslmode=require"

# Aiven Redis / Managed Redis Connection String
# TLS is automatically enabled when using the rediss:// scheme.
# Example (Aiven): rediss://default:PASSWORD@redis-123.aivencloud.com:23457
REDIS_URL="rediss://default:password@host:6379"

# =============================================================================
# 2. CORE SECURITY & TOKENS (REQUIRED)
# =============================================================================
# Strong secret used to sign API JWTs (Minimum 32 random characters recommended)
JWT_SECRET="replace-with-a-very-strong-production-jwt-secret-key-32chars"

# 32-character encryption key for encrypting sensitive app secrets in DB
ENCRYPTION_KEY="replace-with-32-char-encryption-key!"

# Secret used to sign outgoing webhook payloads sent to merchant apps
WEBHOOK_SIGNING_SECRET="replace-with-webhook-signing-secret"

# Shared secret token for inter-service communication between Flow Admin & FlowPay
FLOWPAY_INTERNAL_TOKEN="replace-with-shared-internal-token-32chars"

# =============================================================================
# 3. SERVER & DOMAIN CONFIGURATION
# =============================================================================
# Port provided dynamically by hosting platform (Render sets PORT automatically)
PORT=3011

# Dedicated standalone worker health port. Keep distinct from PORT.
WORKER_HEALTH_PORT=3012

# Application environment: production, development, or test
NODE_ENV=production

# Public URL of the FlowPay Hosted Checkout web app
# Example: https://checkout.flowpay.com
FLOWPAY_PUBLIC_URL="https://checkout.flowpay.com"

# Public URL of the Flow Admin Platform
# Example: https://admin.flowpay.com
FLOW_ADMIN_URL="https://admin.flowpay.com"

# External URL of the FlowPay API (Used to build public webhook listener endpoints)
# Example: https://api.flowpay.com
FLOWPAY_WEBHOOK_BASE_URL="https://api.flowpay.com"

# Allowed origins for iframe embedding of hosted checkout (comma-separated URLs)
# Example: https://merchant.com,https://app.merchant.com
CHECKOUT_EMBED_ORIGINS="https://checkout.flowpay.com,https://admin.flowpay.com"

# =============================================================================
# 4. PAYMENT GATEWAY INTEGRATIONS (CONFIGURE AS NEEDED)
# =============================================================================

# --- CamPay (Cameroon - Mobile Money) ---
CAMPAY_BASE_URL="https://www.campay.net"
CAMPAY_USERNAME=""
CAMPAY_PASSWORD=""
CAMPAY_PUBLIC_KEY=""
CAMPAY_SECRET_KEY=""
CAMPAY_API_KEY=""
CAMPAY_API_SECRET=""
CAMPAY_WEBHOOK_SECRET=""
CAMPAY_APP_ID=""

# --- Fapshi (Cameroon - Mobile Money / Orange & MTN) ---
# Sandbox credentials (used when provider mode is set to Sandbox)
FAPSHI_SANDBOX_BASE_URL="https://sandbox.fapshi.com"
FAPSHI_SANDBOX_API_KEY_USER=""
FAPSHI_SANDBOX_API_KEY=""
FAPSHI_SANDBOX_WEBHOOK_SECRET=""

# Live credentials (used when provider mode is set to Live in production)
FAPSHI_BASE_URL="https://live.fapshi.com"
FAPSHI_LIVE_BASE_URL="https://live.fapshi.com"
FAPSHI_LIVE_API_KEY_USER=""
FAPSHI_LIVE_API_KEY=""
FAPSHI_LIVE_WEBHOOK_SECRET=""

# --- Maviance / Smobilpay (Cameroon) ---
MAVIANCE_BASE_URL="https://api.maviance.com"
MAVIANCE_PUBLIC_KEY=""
MAVIANCE_SECRET_KEY=""
MAVIANCE_API_KEY=""
MAVIANCE_SECRET=""

# --- CinetPay (Francophone Africa) ---
CINETPAY_BASE_URL="https://api-checkout.cinetpay.com"
CINETPAY_PUBLIC_KEY=""
CINETPAY_SECRET_KEY=""
CINETPAY_API_KEY=""
CINETPAY_SECRET=""
CINETPAY_SITE_ID=""

# --- Flutterwave (v4 API / Global & Regional) ---
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_ENCRYPTION_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET=""

# --- Monetbil (Cameroon / Central Africa) ---
MONETBIL_SERVICE_KEY=""
MONETBIL_SERVICE_SECRET=""

# =============================================================================
# 5. TIMEOUTS & ADVANCED TUNING
# =============================================================================
GATEWAY_REQUEST_TIMEOUT_MS=30000
